{
  "schemaVersion": 1,
  "mode": "accuracy-first",
  "description": "Borderly Data v17 accuracy-first and commercial-source policy. Passport Index core categories are synchronized exactly to a pinned MIT snapshot, explicit official rules have priority, and non-core destinations are controlled only by certified Borderly territory policies.",
  "sourcePriority": {
    "official-policy": 100,
    "official-watch": 95,
    "special-mobility": 95,
    "verified-manual": 90,
    "passport-index-core": 70,
    "territory-registry": 25
  },
  "automaticChanges": {
    "allowSameStatusDayUpdates": true,
    "allowPassportIndexCategoryRefresh": true,
    "requirePassportIndexSnapshotExactness": true,
    "allowUnverifiedCategoryChanges": false,
    "allowTerritoryDerivationRefresh": false,
    "freezeExistingNonCoreDestinations": true
  },
  "candidateLimits": {
    "maxTotalCategoryChanges": 250,
    "maxCategoryChangesPerPassport": 12,
    "maxCategoryChangesPerDestination": 30,
    "maxUnverifiedCategoryChanges": 0,
    "maxUnverifiedRestrictiveChanges": 0,
    "maxNewFreedomRules": 0
  },
  "sensitiveStatuses": [
    "freedom",
    "entry restricted",
    "no admission",
    "special permit",
    "mixed requirements"
  ],
  "restrictiveStatuses": [
    "visa required",
    "entry restricted",
    "no admission"
  ]
}
